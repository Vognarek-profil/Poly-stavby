{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "poly-stavby.vercel.app" }],
      "destination": "https://www.poly-stavby.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "poly-stavby.vercel.app" }],
      "destination": "https://www.poly-stavby.cz/:path*",
      "permanent": true
    }
  ]
}
